-- Create the one community organization and its first administrator. There is
-- no signup route and the schema prevents a second organization.
--
-- Copy this file to 04-bootstrap-admin.sql, replace the email/hash below,
-- before first `docker compose up` (docker-entrypoint-initdb.d only runs
-- against an empty data volume). Generate a hash with:
--   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(rounds=12)).decode())"
-- 04-bootstrap-admin.sql itself is gitignored — it holds a real (if one-way
-- hashed) credential, unlike this template.
WITH organization AS (
  INSERT INTO endpt.companies (slug, name, vpn_subnet)
  VALUES ('organization', 'My Organization', '10.10.0.0/24')
  ON CONFLICT (slug) DO UPDATE SET name = EXCLUDED.name
  RETURNING id
)
INSERT INTO endpt.admin_users (email, password_hash, full_name, role, company_id)
SELECT
    'admin@example.com',
    '$2b$12$change-me-generate-a-real-bcrypt-hash',
    'Admin',
    'company_admin',
    organization.id
FROM organization;
