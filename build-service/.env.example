# ── Warden Build Service — Environment Variables ───────────────────────────────
# Copy this file to .env. This service polls for new build requests,
# cross-compiles agent-go (GOOS=windows GOARCH=amd64 — pure Go, no cgo, runs
# fine in the Linux container this ships as, see Dockerfile), and uploads the
# resulting installer zip back to the server.

# ── Database (self-hosted Postgres + PostgREST) ────────────────────────────────
# http:// only safe because this stays on the private warden-net Docker
# network — see server/.env's identical comment.
SUPABASE_URL=http://postgrest:3000
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key...

# ── Build environment ───────────────────────────────────────────────────────────
# Bind-mounted read-only from the repo's agent-go/ (see docker-compose.yml)
AGENT_GO_SOURCE_DIR=/agent-go

# Named volume, scratch space for in-progress builds
OUTPUT_DIR=/build-output

# ── Warden server ───────────────────────────────────────────────────────────────
# Internal container-to-container URL — avoids round-tripping large
# installer uploads through Cloudflare/nginx (and their rate limits).
WARDEN_SERVER_URL=http://warden-server:35020

# API key shared between build service and Warden server (must match server .env)
BUILD_SERVICE_KEY=change-me-generate-with-secrets-token-hex-32

# Human-facing Windows Services/MSI/signing-description metadata. The internal
# WardenAgent service name and paths remain stable for safe upgrades.
AGENT_DISPLAY_NAME=Warden Endpoint Agent
AGENT_MANUFACTURER=Warden

# ── Polling ─────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=15

# ── Code signing (optional) ──────────────────────────────────────────────────────
# Leave blank while developing to ship warden-agent.exe unsigned (logged as
# a warning per build). Before production rollout, install the certificate,
# set SIGN_PFX_PATH, then set SIGNING_REQUIRED=true so signing can never be
# silently skipped. SIGN_PFX_PATH is signed via osslsigncode
# (Linux-native, bundled in the Dockerfile) — bind-mount your .pfx into the
# container and point this at it, e.g. add to docker-compose.yml's
# build-service volumes: - ./certs:/certs:ro, then SIGN_PFX_PATH=/certs/warden-codesign.pfx
#SIGN_PFX_PATH=
#SIGN_PFX_PASSWORD=
#SIGNING_REQUIRED=false
# Require this only when the signing certificate chains to a root installed
# in every managed PC's Windows trust store. Private/self-signed test certs
# otherwise produce WinVerifyTrust 0x800b0109 during remote updates.
# Pinned HTTPS and a server-supplied SHA-256 are always enforced regardless.
#REQUIRE_AUTHENTICODE_UPDATES=false
# RFC 3161 timestamp endpoint. Keep this separate from the certificate so it
# can be changed without rebuilding application configuration.
#SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
# SIGN_CERT_THUMBPRINT is Windows cert-store-only — NOT supported in this
# Linux container. Setting it fails the build loudly (see builder.py).
#SIGN_CERT_THUMBPRINT=
