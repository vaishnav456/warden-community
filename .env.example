# Docker Compose bootstrap values. Copy to .env and replace every value.
# Generate independent random values; do not reuse application or signing keys.
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
POSTGREST_AUTHENTICATOR_PASSWORD=change-me-generate-a-long-random-password
POSTGREST_JWT_SECRET=change-me-generate-at-least-32-random-bytes
