* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.vcxproj text eol=crlf
*.sln text eol=crlf
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
*.zip binary

# Preserve upstream legal texts, including their whitespace and RST headings.
# Application source remains subject to normal diff/merge-marker checks.
third_party/licenses/** -whitespace conflict-marker-size=32
server/static/vendor/licenses/** -whitespace conflict-marker-size=32
server/static/fonts/*/LICENSE.txt -whitespace conflict-marker-size=32
