root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[{*.go,go.mod,go.sum}]
indent_style = tab

[{*.yml,*.yaml,*.json,*.html,*.css,*.js,*.md}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
