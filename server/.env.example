# ── Warden Server — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in all values before starting the server.
# NEVER commit .env to git.

# ── Database (self-hosted Postgres + PostgREST) ────────────────────────────────
# Replaces hosted Supabase — db.py speaks PostgREST's wire protocol
# (Accept-Profile/Content-Profile headers), so this can point at any
# PostgREST instance. See db-init/ for the roles/schema it expects.
# http:// is only safe if postgres/postgrest never leave a private Docker
# network (no published port, no public route) — see docker-compose.yml.
SUPABASE_URL=http://postgrest:3000
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-jwt...

# ── Flask ───────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
DEBUG=false
PORT=35020
# 0.0.0.0 if fronted by a reverse proxy over a Docker network (reached by
# container name, not loopback); 127.0.0.1 if the proxy runs on the same
# host and reaches this app via localhost only.
HOST=0.0.0.0
# Set to true ONLY if Cloudflare Tunnel (or another trusted proxy setting
# CF-Connecting-IP) is the sole ingress path to this app — trusts that
# header for firewall/rate-limit IP checks. Leave false if fronted by Caddy
# on the same host instead (relies on ProxyFix + X-Forwarded-For).
TRUST_CLOUDFLARE=true

# ── Cloudflare Client Certificates (mTLS) ────────────────────────────────────
# See server/services/agent_ca.py and docs/MTLS_DEPLOYMENT.md.
# Requires a Cloudflare API token scoped to "SSL and Certificates: Edit" for
# CLOUDFLARE_ZONE_ID (the zone for the Warden API's hostname).
CLOUDFLARE_API_TOKEN=change-me-cloudflare-api-token
CLOUDFLARE_ZONE_ID=change-me-cloudflare-zone-id
# Set to true ONLY once TRUST_CLOUDFLARE is also true, mTLS is enabled for
# the relevant hostname in the Cloudflare dashboard, and
# client_certificate_forwarding is enabled on the zone (so
# Cf-Client-Cert-Sha256 actually arrives). Otherwise every agent request
# gets rejected for lacking a header Cloudflare was never told to send.
REQUIRE_CLIENT_CERT=false

# Remote admission automatically follows CPU/memory/HTTP/relay pressure.
# No fixed per-tenant session allowance; existing sessions are preserved.
# Workers must remain single-process until registries/schedulers are distributed.

# ── Warden private device PKI ────────────────────────────────────────────────
# Identifies endpoint agents and Warden Home Nodes. The 24-hour notBefore
# tolerance lets a restored/suspended machine recover even when its clock is
# temporarily stale; certificate expiry is still seven days from issuance.
DEVICE_CERTIFICATES_ENABLED=true
DEVICE_CA_AUTO_BOOTSTRAP=false
# Comma-separated STUN discovery services for direct-only Warden Home P2P.
# STUN sees peer public addresses but never carries file data. Do not add TURN
# URLs unless organization-approved relaying is intentionally implemented later.
HOME_P2P_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
HOME_NODE_VERSION=1.1.7
DEVICE_CA_DIR=/var/lib/warden/device-ca
DEVICE_CERT_VALIDITY_DAYS=7
DEVICE_CERT_CLOCK_SKEW_HOURS=24

# ── Organization encryption ───────────────────────────────────────────────────
# The legacy name is retained for upgrade compatibility. It wraps the single
# organization's data-encryption key and never encrypts application data
# directly. Required before first authenticated use.
# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TENANT_MASTER_KEK_B64=change-me-generate-32-random-bytes-base64

# ── JWT / Session ───────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SESSION_COOKIE_SECURE=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_CONCURRENT_SESSIONS=3

# ── Ed25519 Command Signing ─────────────────────────────────────────────────────
# Generate with:
#   python3 -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, NoEncryption
#   import base64
#   k = Ed25519PrivateKey.generate()
#   print(base64.b64encode(k.private_bytes(Encoding.Raw, PrivateFormat.Raw, NoEncryption())).decode())
#   "
# The matching public key is distributed to agents automatically at enrollment.
ED25519_PRIVATE_KEY_B64=change-me-generate-ed25519-private-key-base64
COMMAND_MAX_AGE_SEC=60
# Windows application-library EXE/MSI packages are verified by WinVerifyTrust
# immediately before SYSTEM executes them. Keep enabled in production.
REQUIRE_SIGNED_WINDOWS_APPS=true

# ── Public server URL ─────────────────────────────────────────────────────────
# Used to build the relay_url agents connect to and the config.json baked
# into installers. The TLS pin for new installers is fetched live at
# generate-installer time (services/cert_fingerprint.py) — no fingerprint
# to maintain here.
SERVER_URL=https://warden.example.com

# ── Operator branding ────────────────────────────────────────────────────────
# Human-facing label and tagline used by the web console and identity setup.
# Put a custom SVG/PNG under server/static/ and use its same-origin path here.
# Internal service names, paths, API routes, and protocol identifiers stay
# stable across upgrades and are intentionally not rebrandable.
BRAND_NAME=Warden
BRAND_TAGLINE=Endpoint control, made clear.
#BRAND_LOGO_PATH=/static/custom-brand.svg

# ── Enrollment tokens ───────────────────────────────────────────────────────────
ENROLL_TOKEN_HOURS=24

# ── Escalation ──────────────────────────────────────────────────────────────────
ESCALATION_WINDOW_MINUTES=15

# ── Build service ───────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must match BUILD_SERVICE_KEY in build-service/.env
BUILD_SERVICE_KEY=change-me-generate-with-secrets-token-hex-32

# ── noVNC / websockify remote access ────────────────────────────────────────────
NOVNC_TOKEN_DIR=/tmp/warden-vnc-tokens
WEBSOCKIFY_PORT=6080
